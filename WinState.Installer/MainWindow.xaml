<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinState.Installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WinState.Installer"
    Title="WinState Installer">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar zone (drag-to-move). Window backdrop + title text set in code-behind. -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              Background="Transparent">
            <TextBlock x:Name="TitleBarText"
                       Text="WinState Setup"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontWeight="SemiBold"/>
        </Grid>

        <!-- Wizard step host. Pages are CTL'd via NavigationFrame.Navigate from MainWindow.xaml.cs. -->
        <Frame x:Name="NavigationFrame"
               Grid.Row="1"
               Padding="32,16,32,16"/>

        <!-- Navigation buttons. Visibility / enabled is driven by the active page. -->
        <Grid Grid.Row="2"
              Padding="32,16,32,24"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="{x:Bind loc:L.Instance.Cancel, Mode=OneWay}"
                    Click="CancelButton_Click"
                    MinWidth="100"/>

            <Button x:Name="BackButton"
                    Grid.Column="2"
                    Content="{x:Bind loc:L.Instance.Back, Mode=OneWay}"
                    Click="BackButton_Click"
                    IsEnabled="False"
                    MinWidth="100"/>

            <Button x:Name="NextButton"
                    Grid.Column="3"
                    Content="Next"
                    Click="NextButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="100"/>
        </Grid>
    </Grid>
</Window>
