<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinState.Installer.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeadingText"
                   Text="Installing"
                   FontSize="24"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1" x:Name="CurrentStepText"
                   Text="Starting..."
                   Opacity="0.8"/>

        <ProgressBar Grid.Row="2" x:Name="ProgressBar"
                     IsIndeterminate="True"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <TextBlock x:Name="LogText"
                       FontFamily="Consolas"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"/>
        </ScrollViewer>
    </Grid>
</Page>
