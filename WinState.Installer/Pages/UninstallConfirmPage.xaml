<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinState.Installer.Pages.UninstallConfirmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WinState.Installer">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind loc:L.UninstallConfirmTitle}"
                   FontSize="28"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1"
                   Text="{x:Bind loc:L.UninstallConfirmBody}"
                   TextWrapping="Wrap"
                   Opacity="0.8"/>

        <StackPanel Grid.Row="2" Spacing="12" Margin="0,8,0,0">
            <CheckBox x:Name="RemoveSettingsCheckbox" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="{x:Bind loc:L.UninstallRemoveSettings}"/>
                    <TextBlock Text="{x:Bind loc:L.UninstallRemoveSettingsDesc}"
                               Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="RemovePawnIOCheckbox" IsChecked="False">
                <StackPanel>
                    <TextBlock Text="{x:Bind loc:L.UninstallRemovePawnIO}"/>
                    <TextBlock Text="{x:Bind loc:L.UninstallRemovePawnIODesc}"
                               Opacity="0.7" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
    </Grid>
</Page>
