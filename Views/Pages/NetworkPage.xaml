<Page x:Class="WinState.Views.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:WinState.Views.Pages"
      Title="NetworkPage"
      d:DataContext="{d:DesignInstance local:NetworkPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d">

    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Network" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Upload: " FontSize="14"/>
                <TextBlock Text="{Binding ViewModel.NetworkUpload, StringFormat='{}{0:F1}'}" FontSize="14"/>
                <TextBlock Text="{Binding ViewModel.NetworkUploadUnit}" FontSize="14" Margin="5,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Download: " FontSize="14"/>
                <TextBlock Text="{Binding ViewModel.NetworkDownload, StringFormat='{}{0:F1}'}" FontSize="14"/>
                <TextBlock Text="{Binding ViewModel.NetworkDownloadUnit}" FontSize="14" Margin="5,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding ViewModel.LocalIpAddress, StringFormat='Local IP: {0}'}" FontSize="14"/>
            <TextBlock Text="{Binding ViewModel.PublicIpAddress, StringFormat='Public IP: {0}'}" FontSize="14"/>
        </StackPanel>
    </Grid>
</Page>