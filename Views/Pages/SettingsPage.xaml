<UserControl
    x:Class="WinState.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:WinState.Helpers"
    xmlns:local="clr-namespace:WinState.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="650"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <!--  ===== 外觀 =====  -->
            <TextBlock Style="{StaticResource SettingsTitle}" Text="外觀" />

            <Border Style="{StaticResource SettingsGroup}">
                <Grid Margin="16,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="PaintBrush24" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="佈景主題" />
                        <TextBlock Style="{StaticResource SettingsRowCaption}" Text="選擇應用程式的亮色或暗色外觀。" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <RadioButton
                            Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                            CommandParameter="theme_light"
                            Content="Light"
                            GroupName="themeSelect"
                            IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
                        <RadioButton
                            Margin="16,0,0,0"
                            Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                            CommandParameter="theme_dark"
                            Content="Dark"
                            GroupName="themeSelect"
                            IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ===== 一般 =====  -->
            <TextBlock
                Margin="2,16,0,18"
                Style="{StaticResource SettingsTitle}"
                Text="一般" />

            <Border Style="{StaticResource SettingsGroup}">
                <Grid Margin="16,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="Power24" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="開機時自動啟動" />
                        <TextBlock Style="{StaticResource SettingsRowCaption}" Text="登入 Windows 時，自動以系統管理員權限啟動 WinState。" />
                    </StackPanel>

                    <ui:ToggleSwitch
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ViewModel.StartWithWindows, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!--  ===== 系統匣圖示 =====  -->
            <TextBlock
                Margin="2,16,0,18"
                Style="{StaticResource SettingsTitle}"
                Text="系統匣圖示" />

            <TextBlock
                Style="{StaticResource SettingsGroupLabel}"
                Text="勾選要顯示的項目並調整順序；百分比圖示可設定變色門檻（黃 / 橘 / 紅）。" />

            <Border Style="{StaticResource SettingsGroup}">
                <ItemsControl Margin="8,8" ItemsSource="{Binding ViewModel.TrayIcons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,3"
                                Padding="10,8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsVisible}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontWeight="Medium"
                                            Text="{Binding DisplayName}" />

                                        <ui:Button
                                            Grid.Column="2"
                                            Margin="4,0"
                                            Padding="8,4"
                                            Appearance="Secondary"
                                            Command="{Binding DataContext.ViewModel.MoveIconUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon ChevronUp24}"
                                            ToolTip="上移" />

                                        <ui:Button
                                            Grid.Column="3"
                                            Padding="8,4"
                                            Appearance="Secondary"
                                            Command="{Binding DataContext.ViewModel.MoveIconDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon ChevronDown24}"
                                            ToolTip="下移" />
                                    </Grid>

                                    <!--  Warning thresholds (percentage icons only)  -->
                                    <StackPanel
                                        Margin="0,10,0,2"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsPercentageIcon, Converter={StaticResource BoolToVis}}">
                                        <TextBlock
                                            Width="40"
                                            VerticalAlignment="Center"
                                            Foreground="Goldenrod"
                                            Text="黃 %" />
                                        <ui:NumberBox
                                            Width="130"
                                            Margin="0,0,12,0"
                                            Maximum="100"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding WarnThreshold, Mode=TwoWay}" />
                                        <TextBlock
                                            Width="40"
                                            VerticalAlignment="Center"
                                            Foreground="Orange"
                                            Text="橘 %" />
                                        <ui:NumberBox
                                            Width="130"
                                            Margin="0,0,12,0"
                                            Maximum="100"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding HighThreshold, Mode=TwoWay}" />
                                        <TextBlock
                                            Width="40"
                                            VerticalAlignment="Center"
                                            Foreground="OrangeRed"
                                            Text="紅 %" />
                                        <ui:NumberBox
                                            Width="130"
                                            Maximum="100"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding CriticalThreshold, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding ViewModel.ResetIconOrderCommand}"
                    Content="還原預設"
                    Icon="{ui:SymbolIcon ArrowReset24}" />
            </StackPanel>

            <ui:InfoBar
                Margin="0,12,0,0"
                IsOpen="{Binding ViewModel.HasUnsavedChanges}"
                Message="圖示順序與顯示的變更會在重新啟動應用程式後生效（門檻變更即時套用）。"
                Severity="Informational"
                Title="需要重新啟動" />

            <!--  ===== 程序清單 =====  -->
            <TextBlock
                Margin="2,16,0,18"
                Style="{StaticResource SettingsTitle}"
                Text="程序清單" />

            <TextBlock
                Style="{StaticResource SettingsGroupLabel}"
                Text="每個分頁的程序清單顯示的項目數量（1–50）。" />

            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <!--  CPU  -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="Board24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="CPU" />
                        <ui:NumberBox Grid.Column="2" Width="140" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.CpuProcessCount, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <!--  Memory  -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="DeveloperBoard24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="記憶體" />
                        <ui:NumberBox Grid.Column="2" Width="140" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.MemoryProcessCount, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <!--  Network  -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="NetworkCheck24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="網路" />
                        <ui:NumberBox Grid.Column="2" Width="140" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.NetworkProcessCount, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <!--  Disk  -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="Storage24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="磁碟" />
                        <ui:NumberBox Grid.Column="2" Width="140" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.DiskProcessCount, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 更新頻率 =====  -->
            <TextBlock
                Margin="2,16,0,18"
                Style="{StaticResource SettingsTitle}"
                Text="更新頻率" />

            <TextBlock
                Style="{StaticResource SettingsGroupLabel}"
                Text="每個類別資料的重新整理間隔，單位毫秒（250–10000）。隱藏在系統匣時會自動放慢以節省資源。" />

            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="Board24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="CPU" />
                        <ui:NumberBox Grid.Column="2" Width="150" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.CpuRefreshMs, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="Video24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="GPU" />
                        <ui:NumberBox Grid.Column="2" Width="150" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.GpuRefreshMs, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="DeveloperBoard24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="記憶體" />
                        <ui:NumberBox Grid.Column="2" Width="150" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.MemoryRefreshMs, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="Storage24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="磁碟" />
                        <ui:NumberBox Grid.Column="2" Width="150" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.DiskRefreshMs, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="NetworkCheck24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="網路" />
                        <ui:NumberBox Grid.Column="2" Width="150" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.NetworkRefreshMs, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 關於 =====  -->
            <TextBlock
                Margin="2,16,0,18"
                Style="{StaticResource SettingsTitle}"
                Text="關於" />

            <Border Style="{StaticResource SettingsGroup}">
                <Grid Margin="16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Column="0"
                        Width="56"
                        Height="56"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Source="pack://application:,,,/Assets/wpfui-icon-256.png" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="WinState" />
                        <TextBlock
                            Style="{StaticResource SettingsRowCaption}"
                            Text="輕量系統監控工具" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource SettingsRowCaption}"
                            Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ===== 貢獻者 =====  -->
            <TextBlock
                Margin="2,16,0,18"
                Style="{StaticResource SettingsTitle}"
                Text="貢獻者" />

            <TextBlock
                Style="{StaticResource SettingsGroupLabel}"
                Text="感謝所有為 WinState 付出的人。" />

            <Border Style="{StaticResource SettingsGroup}">
                <ItemsControl Margin="0,4" ItemsSource="{Binding ViewModel.Contributors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" Margin="0,0,14,0" CornerRadius="18">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingsRowTitle}"
                                    Text="{Binding Login}" />
                                <ui:HyperlinkButton
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="GitHub"
                                    NavigateUri="{Binding ProfileUrl}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
