<Page
    x:Class="WinState.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:WinState.Helpers"
    xmlns:local="clr-namespace:WinState.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SettingsPage"
    d:DataContext="{d:DesignInstance local:SettingsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,24,0,4" />
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <!--  ============ 外觀 ============  -->
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionTitle}"
                Text="外觀" />

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="PaintBrush24" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="佈景主題" />
                        <TextBlock Style="{StaticResource CardCaption}" Text="選擇應用程式的亮色或暗色外觀。" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <RadioButton
                            Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                            CommandParameter="theme_light"
                            Content="Light"
                            GroupName="themeSelect"
                            IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
                        <RadioButton
                            Margin="16,0,0,0"
                            Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                            CommandParameter="theme_dark"
                            Content="Dark"
                            GroupName="themeSelect"
                            IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ============ 系統匣圖示 ============  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="系統匣圖示" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="AppsList24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="圖示順序、顯示與警示門檻" />
                            <TextBlock Style="{StaticResource CardCaption}" Text="勾選要顯示的項目並調整順序；百分比圖示可設定變色門檻（黃 / 橘 / 紅）。" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ViewModel.TrayIcons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,4"
                                    Padding="12,8"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                Grid.Column="0"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsVisible}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Text="{Binding DisplayName}" />

                                            <ui:Button
                                                Grid.Column="2"
                                                Margin="4,0"
                                                Padding="8,4"
                                                Appearance="Secondary"
                                                Command="{Binding DataContext.ViewModel.MoveIconUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ChevronUp24}"
                                                ToolTip="上移" />

                                            <ui:Button
                                                Grid.Column="3"
                                                Padding="8,4"
                                                Appearance="Secondary"
                                                Command="{Binding DataContext.ViewModel.MoveIconDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ChevronDown24}"
                                                ToolTip="下移" />
                                        </Grid>

                                        <!--  Warning thresholds (percentage icons only)  -->
                                        <StackPanel
                                            Margin="0,10,0,2"
                                            Orientation="Horizontal"
                                            Visibility="{Binding IsPercentageIcon, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                Width="40"
                                                VerticalAlignment="Center"
                                                Foreground="Goldenrod"
                                                Text="黃 %" />
                                            <ui:NumberBox
                                                Width="92"
                                                Margin="0,0,12,0"
                                                Maximum="100"
                                                Minimum="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding WarnThreshold, Mode=TwoWay}" />
                                            <TextBlock
                                                Width="40"
                                                VerticalAlignment="Center"
                                                Foreground="Orange"
                                                Text="橘 %" />
                                            <ui:NumberBox
                                                Width="92"
                                                Margin="0,0,12,0"
                                                Maximum="100"
                                                Minimum="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding HighThreshold, Mode=TwoWay}" />
                                            <TextBlock
                                                Width="40"
                                                VerticalAlignment="Center"
                                                Foreground="OrangeRed"
                                                Text="紅 %" />
                                            <ui:NumberBox
                                                Width="92"
                                                Maximum="100"
                                                Minimum="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding CriticalThreshold, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button
                        Margin="0,12,0,0"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.ResetIconOrderCommand}"
                        Content="還原預設"
                        Icon="{ui:SymbolIcon ArrowReset24}" />

                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="{Binding ViewModel.HasUnsavedChanges}"
                        Message="圖示順序與顯示的變更會在重新啟動應用程式後生效（門檻變更即時套用）。"
                        Severity="Informational"
                        Title="需要重新啟動" />
                </StackPanel>
            </Border>

            <!--  ============ 程序清單 ============  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="程序清單" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="AppsListDetail24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="各分頁程序顯示數量" />
                            <TextBlock Style="{StaticResource CardCaption}" Text="每個分頁的程序清單顯示的項目數量（1–50）。" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="CPU" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="1" Width="120" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.CpuProcessCount, Mode=TwoWay}" />

                        <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Text="記憶體" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="4" Width="120" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.MemoryProcessCount, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="網路" />
                        <ui:NumberBox Grid.Row="2" Grid.Column="1" Width="120" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.NetworkProcessCount, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Text="磁碟" />
                        <ui:NumberBox Grid.Row="2" Grid.Column="4" Width="120" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.DiskProcessCount, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ============ 更新頻率 ============  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="更新頻率" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="ArrowSync24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="各類別更新間隔" />
                            <TextBlock Style="{StaticResource CardCaption}" Text="每個類別資料的重新整理間隔，單位毫秒（250–10000）。" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="CPU" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="1" Width="120" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.CpuRefreshMs, Mode=TwoWay}" />

                        <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Text="GPU" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="4" Width="120" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.GpuRefreshMs, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="記憶體" />
                        <ui:NumberBox Grid.Row="2" Grid.Column="1" Width="120" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.MemoryRefreshMs, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Text="磁碟" />
                        <ui:NumberBox Grid.Row="2" Grid.Column="4" Width="120" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.DiskRefreshMs, Mode=TwoWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="網路" />
                        <ui:NumberBox Grid.Row="4" Grid.Column="1" Width="120" Maximum="10000" Minimum="250" SmallChange="250" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.NetworkRefreshMs, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ============ 關於 ============  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="關於" />

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="Info24" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="WinState" />
                        <TextBlock
                            Style="{StaticResource CardCaption}"
                            Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
