<Page
    x:Class="WinState.Views.Pages.ProcessListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WinState.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ProcessListPage"
    d:DesignHeight="650"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Left"
            Margin="0,0,0,24">

            <TextBlock Style="{StaticResource SettingsTitle}" Text="程序清單" />

            <TextBlock
                Style="{StaticResource SettingsGroupLabel}"
                Text="每個分頁的程序清單顯示的項目數量（1–50）。" />

            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <!--  CPU  -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="Board24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="CPU" />
                        <ui:NumberBox Grid.Column="2" Width="120" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.CpuProcessCount, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <!--  Memory  -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="DeveloperBoard24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="記憶體" />
                        <ui:NumberBox Grid.Column="2" Width="120" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.MemoryProcessCount, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <!--  Network  -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="NetworkCheck24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="網路" />
                        <ui:NumberBox Grid.Column="2" Width="120" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.NetworkProcessCount, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsDivider}" />

                    <!--  Disk  -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20" Symbol="Storage24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitle}" Text="磁碟" />
                        <ui:NumberBox Grid.Column="2" Width="120" Maximum="50" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ViewModel.DiskProcessCount, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
