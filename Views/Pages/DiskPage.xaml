<Page
    x:Class="WinState.Views.Pages.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WinState.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DiskPage"
    d:DataContext="{d:DesignInstance local:DiskPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="900"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SmartChip" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="磁碟" />

            <!--  Global throughput  -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Margin="0,0,6,0" Fill="{StaticResource GraphBlueBrush}" RadiusX="3" RadiusY="3" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="讀取" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Text="{Binding Main.DiskReadSpeedString}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Main.DiskPeakReadString, StringFormat='峰值 {0}'}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Margin="0,0,6,0" Fill="{StaticResource GraphRedBrush}" RadiusX="3" RadiusY="3" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="寫入" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Text="{Binding Main.DiskWriteSpeedString}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Main.DiskPeakWriteString, StringFormat='峰值 {0}'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Per-disk cards  -->
            <ItemsControl ItemsSource="{Binding Main.Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="{Binding DriveName}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Name}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding DiskFreeSpaceString}" />
                                </Grid>

                                <ProgressBar
                                    Height="6"
                                    Margin="0,0,0,4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Foreground="{StaticResource GraphBlueBrush}"
                                    Maximum="100"
                                    Value="{Binding UsedPercentage, Mode=OneWay}" />
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding UsedString}" />

                                <!--  SMART chips  -->
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Style="{StaticResource SmartChip}">
                                        <TextBlock Margin="0,0,3,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="型號" />
                                        <TextBlock Text="{Binding Model}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SmartChip}">
                                        <TextBlock Margin="0,0,3,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="溫度" />
                                        <TextBlock Text="{Binding TemperatureString}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SmartChip}">
                                        <TextBlock Margin="0,0,3,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="健康" />
                                        <TextBlock Text="{Binding HealthString}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SmartChip}">
                                        <TextBlock Margin="0,0,3,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="運轉" />
                                        <TextBlock Text="{Binding PowerOnHoursString}" />
                                    </StackPanel>
                                </WrapPanel>

                                <!--  Per-disk read/write graph  -->
                                <Border
                                    Height="64"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    ClipToBounds="True"
                                    CornerRadius="4">
                                    <Grid>
                                        <StackPanel
                                            Margin="0,2,6,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,3,0"
                                                FontSize="10"
                                                Foreground="{StaticResource GraphBlueBrush}"
                                                Text="R" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{StaticResource GraphBlueBrush}"
                                                Text="{Binding ReadSpeedString}" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="0,0,6,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,3,0"
                                                FontSize="10"
                                                Foreground="{StaticResource GraphRedBrush}"
                                                Text="W" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{StaticResource GraphRedBrush}"
                                                Text="{Binding WriteSpeedString}" />
                                        </StackPanel>
                                        <Viewbox Stretch="Fill">
                                            <Grid Width="280" Height="40">
                                                <Polygon Points="{Binding ReadHistoryPoints}" Fill="{StaticResource GraphBlueFillBrush}" />
                                                <Polyline Points="{Binding ReadHistoryPoints}" Stroke="{StaticResource GraphBlueBrush}" StrokeThickness="1.5" />
                                                <Polygon Points="{Binding WriteHistoryPoints}" Fill="{StaticResource GraphRedFillBrush}" />
                                                <Polyline Points="{Binding WriteHistoryPoints}" Stroke="{StaticResource GraphRedBrush}" StrokeThickness="1.5" />
                                                <Line X1="0" Y1="20" X2="280" Y2="20" Stroke="{StaticResource GraphGridBrush}" StrokeThickness="1" />
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Top processes  -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeader}" Text="使用最多的程序" />
                    <ItemsControl ItemsSource="{Binding Main.TopDiskProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding Icon}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource GraphBlueBrush}"
                                            Text="{Binding Read}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource GraphRedBrush}"
                                            Text="{Binding Write}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
