<Page
    x:Class="WinState.Views.Pages.GpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WinState.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GpuPage"
    d:DataContext="{d:DesignInstance local:GpuPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="900"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="GPU" />

            <ItemsControl ItemsSource="{Binding Main.Gpus}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextWrapping="Wrap" />

                                <!--  Processor usage  -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="處理器" />
                                    <ProgressBar
                                        Grid.Column="1"
                                        Margin="6,0"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Foreground="{StaticResource GraphBlueBrush}"
                                        Style="{StaticResource MeterBar}"
                                        Value="{Binding Usage, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding Usage, StringFormat={}{0:0}%}" />
                                </Grid>

                                <!--  Video memory  -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="顯示記憶體" />
                                    <ProgressBar
                                        Grid.Column="1"
                                        Margin="6,0"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Foreground="{StaticResource GraphRedBrush}"
                                        Style="{StaticResource MeterBar}"
                                        Value="{Binding MemoryUsage, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding MemoryUsage, StringFormat={}{0:0}%}" />
                                </Grid>

                                <!--  Details  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="已用記憶體" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding MemoryUsedString}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricLabel}" Text="總記憶體" />
                                    <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource MetricValue}" Text="{Binding MemoryTotalString}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="溫度" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding Temperature, StringFormat={}{0:0} °C}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricLabel}" Text="時脈" />
                                    <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource MetricValue}" Text="{Binding Clock, StringFormat={}{0:0} MHz}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
