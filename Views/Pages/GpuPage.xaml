<Page x:Class="WinState.Views.Pages.GpuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:WinState.Views.Pages"
      Title="GpuPage"
      d:DataContext="{d:DesignInstance local:GpuPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d">

    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="GPU" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <ItemsControl ItemsSource="{Binding ViewModel.Gpus}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Usage, StringFormat='Usage: {0:F1}%'}" FontSize="14"/>
                            <TextBlock Text="{Binding MemoryUsage, StringFormat='Memory Usage: {0:F1}%'}" FontSize="14"/>
                            <TextBlock Text="{Binding MemoryUsedString, StringFormat='Memory Used: {0}'}" FontSize="14"/>
                            <TextBlock Text="{Binding MemoryTotalString, StringFormat='Memory Total: {0}'}" FontSize="14"/>
                            <TextBlock Text="{Binding Temperature, StringFormat='Temperature: {0:F1}°C'}" FontSize="14"/>
                            <TextBlock Text="{Binding Clock, StringFormat='Clock: {0:F0} MHz'}" FontSize="14"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>