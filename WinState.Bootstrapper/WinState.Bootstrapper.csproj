<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe so double-clicking does not flash a console window. The bootstrapper has no UI of
         its own — errors go through User32 MessageBox via P/Invoke. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinState-Setup</AssemblyName>
    <RootNamespace>WinState.Bootstrapper</RootNamespace>
    <!-- Single self-contained file at publish time. The whole point of this project is to wrap
         the installer's "scattered files" output into one downloadable exe. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    payload.zip is generated by scripts/build-installer.ps1 (and CI) right before this project
    is published: the published WinState.Installer folder is zipped and dropped here. Condition
    guards local builds where the zip might not exist yet — the project still compiles and emits
    a clear "payload missing" error at runtime.
  -->
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
  </ItemGroup>

</Project>
