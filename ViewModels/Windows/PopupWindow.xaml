<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="WinState.ViewModels.Windows.PopupWindow"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">
    <Window.Effect>
        <DropShadowEffect/>
    </Window.Effect>
    <Border Background="White" CornerRadius="5" Padding="10" BorderBrush="Gray" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="這是自訂的 UI" Margin="0,0,0,10"/>
            <Button Content="關閉" Click="Close_Click"/>
            <WebBrowser Height="520" Source="https://google.com"/>
        </StackPanel>
    </Border>
</Window>