<Window x:Class="WinState.ViewModels.Windows.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU Monitor"
        Width="320" Height="300"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent">
    <!-- 陰影效果，營造卡片浮動感 -->
    <Window.Effect>
        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black"/>
    </Window.Effect>

    <!-- 白色卡片外觀 -->
    <Border Background="White"
            CornerRadius="8"
            Padding="16"
            BorderBrush="#FFDADADA"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 標題 -->
                <RowDefinition Height="Auto"/>
                <!-- 主要數值 -->
                <RowDefinition Height="*"   />
                <!-- 使用率折線圖或區塊圖 -->
                <RowDefinition Height="Auto"/>
                <!-- 各核心使用率 -->
            </Grid.RowDefinitions>

            <!-- 標題列（可自行加入關閉按鈕） -->
            <TextBlock Grid.Row="0"
                       Text="CPU"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#333333"
                       Margin="0,0,0,8"/>

            <!-- CPU 主要資訊（使用率、溫度、頻率等） -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBlock Text="Usage:" Foreground="#666" />
                <TextBlock Text=" 12%" FontWeight="Bold" Foreground="#333" Margin="4,0,12,0"/>
                <TextBlock Text="Temp:" Foreground="#666" />
                <TextBlock Text=" 63°C" FontWeight="Bold" Foreground="#333" Margin="4,0,12,0"/>
                <TextBlock Text="Freq:" Foreground="#666" />
                <TextBlock Text=" 2.3 GHz" FontWeight="Bold" Foreground="#333" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- CPU 使用率歷史圖（靜態示意，可改用資料繫結動態更新） -->
            <Canvas Grid.Row="2"
                    Height="80"
                    Background="#FFF7F7F7"
                    Margin="0,0,0,8">
                <!-- 以下以 Polyline 模擬折線圖，可依需求改成區域圖、長條圖或第三方圖表套件 -->
                <Polyline Points="0,50 20,40 40,60 60,20 80,30 100,50 120,40 140,70 160,30 180,60 200,40 220,25 240,45 260,60 280,35"
                          Stroke="#FF00AFFF"
                          StrokeThickness="2"/>
            </Canvas>

            <!-- 各核心使用率 (示範 4 核心) -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,0">
                <!-- 每個核心以小型垂直排列呈現標題+進度條 -->
                <StackPanel Margin="6,0" Width="40">
                    <TextBlock Text="Core 1" FontSize="10" Foreground="#666" HorizontalAlignment="Center"/>
                    <ProgressBar Value="30" Maximum="100" Height="8" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="6,0" Width="40">
                    <TextBlock Text="Core 2" FontSize="10" Foreground="#666" HorizontalAlignment="Center"/>
                    <ProgressBar Value="60" Maximum="100" Height="8" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="6,0" Width="40">
                    <TextBlock Text="Core 3" FontSize="10" Foreground="#666" HorizontalAlignment="Center"/>
                    <ProgressBar Value="45" Maximum="100" Height="8" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="6,0" Width="40">
                    <TextBlock Text="Core 4" FontSize="10" Foreground="#666" HorizontalAlignment="Center"/>
                    <ProgressBar Value="80" Maximum="100" Height="8" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
