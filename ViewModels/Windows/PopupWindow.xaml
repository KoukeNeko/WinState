<Window x:Class="WinState.ViewModels.Windows.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border Background="White" CornerRadius="5" Padding="10" BorderBrush="Gray" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="這是自訂的 UI" Margin="0,0,0,10"/>
            <Button Content="關閉" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>