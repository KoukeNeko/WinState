<UserControl x:Class="WinState.ViewModels.Windows.PopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WinState.ViewModels.Windows"
             mc:Ignorable="d" 
             x:Name="Root"
             Width="320">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="UnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <!-- Visibility Styles -->
        <Style x:Key="SectionStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="ALL">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CpuSectionStyle" TargetType="FrameworkElement" BasedOn="{StaticResource SectionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="CPU">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RamSectionStyle" TargetType="FrameworkElement" BasedOn="{StaticResource SectionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="RAM">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NetSectionStyle" TargetType="FrameworkElement" BasedOn="{StaticResource SectionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="NET">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiskSectionStyle" TargetType="FrameworkElement" BasedOn="{StaticResource SectionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="DISK">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GpuSectionStyle" TargetType="FrameworkElement" BasedOn="{StaticResource SectionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="GPU">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DiskGpuContainerStyle" TargetType="FrameworkElement" BasedOn="{StaticResource SectionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="DISK">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="GPU">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeparatorStyle" TargetType="Rectangle">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="#333333"/>
            <Setter Property="Margin" Value="0,15"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="ALL">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <local:RamDashConverter x:Key="RamDashConverter"/>
    </UserControl.Resources>

    <Border Background="#1E1E1E"
            CornerRadius="12"
            BorderBrush="#333333"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- CPU -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="Auto"/> <!-- Memory -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="Auto"/> <!-- Network -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="Auto"/> <!-- Disk & GPU -->
            </Grid.RowDefinitions>

            <!-- CPU Section -->
            <Grid Grid.Row="0" Style="{StaticResource CpuSectionStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <TextBlock Text="CPU" Style="{StaticResource HeaderStyle}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                
                <!-- Graph -->
                <Border Grid.Row="1" Height="100" Margin="0,10,0,10" Background="#1E1E1E" CornerRadius="4" ClipToBounds="True">
                    <Border.ToolTip>
                        <ToolTip Background="#1E1E1E" BorderBrush="#333333" HasDropShadow="True" Placement="Bottom">
                            <StackPanel Margin="5">
                                <TextBlock Text="CORES" Foreground="#3399FF" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                <ItemsControl ItemsSource="{Binding Cores}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2" Background="#252525" CornerRadius="2" Width="60" Height="40" ToolTip="{Binding CurrentUsage, StringFormat={}{0:0}%}">
                                                <Grid>
                                                    <Polyline Points="{Binding HistoryPoints}" Stroke="#FF3333" StrokeThickness="1" VerticalAlignment="Bottom" Stretch="Fill" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>
                    <Canvas x:Name="CpuGraphCanvas">
                        <!-- Grid Lines -->
                        <Line X1="0" Y1="25" X2="280" Y2="25" Stroke="#333333" StrokeThickness="1" StrokeDashArray="2 2"/>
                        <Line X1="0" Y1="50" X2="280" Y2="50" Stroke="#333333" StrokeThickness="1" StrokeDashArray="2 2"/>
                        <Line X1="0" Y1="75" X2="280" Y2="75" Stroke="#333333" StrokeThickness="1" StrokeDashArray="2 2"/>

                        <!-- User Usage (Blue) -->
                        <Polyline Points="{Binding CpuUserHistoryPoints}" Stroke="#3399FF" StrokeThickness="2" />
                        
                        <!-- Kernel Usage (Red) -->
                        <Polyline Points="{Binding CpuKernelHistoryPoints}" Stroke="#FF3333" StrokeThickness="2" />
                    </Canvas>
                </Border>
                
                <!-- Legend -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,15">
                    <Rectangle Width="10" Height="10" Fill="#3399FF" RadiusX="2" RadiusY="2" Margin="0,0,5,0"/>
                    <TextBlock Text="User" Foreground="#AAAAAA" FontSize="12" Margin="0,0,15,0"/>
                    
                    <Rectangle Width="10" Height="10" Fill="#FF3333" RadiusX="2" RadiusY="2" Margin="0,0,5,0"/>
                    <TextBlock Text="System" Foreground="#AAAAAA" FontSize="12" Margin="0,0,15,0"/>
                    
                    <TextBlock Text="{Binding CpuUsage, StringFormat={}Total: {0:0}%}" Foreground="White" FontSize="12" FontWeight="Bold" Margin="20,0,0,0"/>
                </StackPanel>

                <!-- Process List -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="PROCESSES" Style="{StaticResource HeaderStyle}" FontSize="12" Margin="0,0,0,5"/>
                    
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon Placeholder -->
                                    <Border Width="16" Height="16" Background="#333" CornerRadius="2" Margin="0,0,8,0">
                                        <TextBlock Text=">" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                                    </Border>
                                    
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#DDDDDD" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CpuUsage, StringFormat={}{0:0.0}%}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <Rectangle Grid.Row="1" Style="{StaticResource SeparatorStyle}"/>

            <!-- Memory Section -->
            <Grid Grid.Row="2" Style="{StaticResource RamSectionStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Text="RAM" Style="{StaticResource HeaderStyle}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Gauges -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Small Gauge (Placeholder/Pressure) -->
                    <Grid Grid.Column="0" Width="60" Height="60" HorizontalAlignment="Center">
                        <!-- Background Arc -->
                        <Path Stroke="#333" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 10,50 A 25,25 0 1 1 50,50" Stretch="Fill"/>
                        <!-- Value Arc (Static for now or bound to Pressure) -->
                        <Path Stroke="#2ECC71" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 10,50 A 25,25 0 0 1 15,30" Stretch="Fill"/>
                        <!-- Needle/Text -->
                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <Path Fill="#3399FF" Data="M 0,0 L 10,5 L 0,10 Z" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                             <Path.RenderTransform>
                                 <RotateTransform Angle="-90"/>
                             </Path.RenderTransform>
                        </Path>
                    </Grid>

                    <!-- Main RAM Gauge -->
                    <Grid Grid.Column="1" Width="80" Height="80" HorizontalAlignment="Center">
                        <Ellipse Stroke="#333" StrokeThickness="8" Width="80" Height="80"/>
                        <Ellipse Stroke="#3399FF" StrokeThickness="8" Width="80" Height="80"
                                 StrokeDashArray="{Binding RamUsage, Converter={StaticResource RamDashConverter}}"
                                 StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="{Binding RamUsage, StringFormat={}{0:0}%}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2" Text="Usage history" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <!-- Graph -->
                <Border Grid.Row="3" Height="80" Background="#252525" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,15">
                    <Canvas>
                         <!-- Filled Area -->
                        <Polygon Points="{Binding RamHistoryPoints}" Fill="#3399FF" Opacity="0.6"/>
                        <!-- Line on top -->
                        <Polyline Points="{Binding RamHistoryPoints}" Stroke="#3399FF" StrokeThickness="2"/>
                    </Canvas>
                </Border>

                <!-- Details & Processes -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Details -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Details" Foreground="#888" HorizontalAlignment="Center" Grid.ColumnSpan="2" Margin="0,0,0,5"/>

                        <!-- Total -->
                        <TextBlock Grid.Row="1" Text="Total:" Foreground="#888" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RamTotalString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Used -->
                        <TextBlock Grid.Row="2" Text="Used:" Foreground="#888" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamUsedString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- App -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#3399FF" Margin="0,0,5,0"/>
                            <TextBlock Text="App:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RamAppString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Wired (Non-Paged Pool) -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#FFA500" Margin="0,0,5,0"/>
                            <TextBlock Text="Wired:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RamWiredString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Paged Pool -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#FF9933" Margin="0,0,5,0"/>
                            <TextBlock Text="Paged Pool:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RamPagedPoolString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Compressed -->
                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#FF3333" Margin="0,0,5,0"/>
                            <TextBlock Text="Compressed:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RamCompressedString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Cache -->
                        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#33CCFF" Margin="0,0,5,0"/>
                            <TextBlock Text="Cache:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding RamCacheString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Standby -->
                        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#99CCFF" Margin="0,0,5,0"/>
                            <TextBlock Text="Standby:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding RamStandbyString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Modified -->
                        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#FF6699" Margin="0,0,5,0"/>
                            <TextBlock Text="Modified:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding RamModifiedString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Available -->
                        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#99FF99" Margin="0,0,5,0"/>
                            <TextBlock Text="Available:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding RamAvailableString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                        
                         <!-- Free -->
                        <StackPanel Grid.Row="11" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#CCCCCC" Margin="0,0,5,0"/>
                            <TextBlock Text="Free:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding RamFreeString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Committed -->
                        <StackPanel Grid.Row="12" Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Fill="#FFCC00" Margin="0,0,5,0"/>
                            <TextBlock Text="Committed:" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding RamCommittedString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <!-- Commit Limit -->
                        <TextBlock Grid.Row="13" Text="Commit Limit:" Foreground="#888" Margin="0,2"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding RamCommitLimitString}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Top Processes -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Top processes" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopMemoryProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Icon Placeholder -->
                                        <Image Width="16" Height="16" Margin="0,0,8,0" Source="{Binding Icon}" Visibility="Collapsed"/> <!-- Need converter for Icon -->
                                        <Border Width="16" Height="16" Background="#333" CornerRadius="2" Margin="0,0,8,0">
                                            <!-- Simple colored dot based on hash of name? Or just generic -->
                                            <TextBlock Text="M" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#DDDDDD" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedMemoryUsage}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Grid>

            <Rectangle Grid.Row="3" Style="{StaticResource SeparatorStyle}"/>

            <!-- Network Section -->
            <Grid Grid.Row="4" Style="{StaticResource NetSectionStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Upload -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="UPLOAD" Style="{StaticResource HeaderStyle}" Foreground="#E74C3C"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NetworkUploadText, StringFormat={}{0:0.0}, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" KB/s" Style="{StaticResource UnitStyle}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Download -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="DOWNLOAD" Style="{StaticResource HeaderStyle}" Foreground="#2ECC71"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NetworkDownloadText, StringFormat={}{0:0.0}, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" KB/s" Style="{StaticResource UnitStyle}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="5" Style="{StaticResource SeparatorStyle}"/>

            <!-- Disk & GPU Section -->
            <Grid Grid.Row="6" Style="{StaticResource DiskGpuContainerStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Disk -->
                <StackPanel Grid.Column="0" Style="{StaticResource DiskSectionStyle}">
                    <TextBlock Text="DISK" Style="{StaticResource HeaderStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DiskUsage, StringFormat={}{0:0}, Mode=OneWay}" Style="{StaticResource ValueStyle}" FontSize="20"/>
                        <TextBlock Text="%" Style="{StaticResource UnitStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- GPU -->
                <StackPanel Grid.Column="1" Style="{StaticResource GpuSectionStyle}">
                    <TextBlock Text="GPU" Style="{StaticResource HeaderStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GpuUsage, StringFormat={}{0:0}, Mode=OneWay}" Style="{StaticResource ValueStyle}" FontSize="20"/>
                        <TextBlock Text="%" Style="{StaticResource UnitStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
