<UserControl x:Class="WinState.ViewModels.Windows.PopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="320" Height="450">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="UnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#1E1E1E"
            CornerRadius="12"
            BorderBrush="#333333"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- CPU -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="Auto"/> <!-- Memory -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="Auto"/> <!-- Network -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="Auto"/> <!-- Disk & GPU -->
            </Grid.RowDefinitions>

            <!-- CPU Section -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="CPU" Style="{StaticResource HeaderStyle}"/>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:0}, Mode=OneWay}" Style="{StaticResource ValueStyle}"/>
                    <TextBlock Text="%" Style="{StaticResource UnitStyle}"/>
                </StackPanel>

                <!-- Graph -->
                <Border Grid.Row="2" Height="80" Margin="0,10,0,0" Background="#252525" CornerRadius="4" ClipToBounds="True">
                    <Canvas>
                        <Polyline Points="{Binding CpuHistoryPoints, Mode=OneWay}"
                                  Stroke="#007ACC"
                                  StrokeThickness="2"
                                  Fill="#33007ACC"/>
                    </Canvas>
                </Border>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="#333333" Margin="0,15"/>

            <!-- Memory Section -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MEMORY" Style="{StaticResource HeaderStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RamUsage, StringFormat={}{0:0}, Mode=OneWay}" Style="{StaticResource ValueStyle}"/>
                        <TextBlock Text="%" Style="{StaticResource UnitStyle}"/>
                    </StackPanel>
                </StackPanel>
                <!-- Progress Bar (Circular simulation or simple bar) -->
                <ProgressBar Grid.Column="1" Value="{Binding RamUsage, Mode=OneWay}" Maximum="100" Width="100" Height="10" Background="#333" Foreground="#9B59B6" BorderThickness="0"/>
            </Grid>

            <Rectangle Grid.Row="3" Height="1" Fill="#333333" Margin="0,15"/>

            <!-- Network Section -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Upload -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="UPLOAD" Style="{StaticResource HeaderStyle}" Foreground="#E74C3C"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NetworkUploadText, StringFormat={}{0:0.0}, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" KB/s" Style="{StaticResource UnitStyle}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Download -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="DOWNLOAD" Style="{StaticResource HeaderStyle}" Foreground="#2ECC71"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NetworkDownloadText, StringFormat={}{0:0.0}, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" KB/s" Style="{StaticResource UnitStyle}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="5" Height="1" Fill="#333333" Margin="0,15"/>

            <!-- Disk & GPU Section -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Disk -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DISK" Style="{StaticResource HeaderStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DiskUsage, StringFormat={}{0:0}, Mode=OneWay}" Style="{StaticResource ValueStyle}" FontSize="20"/>
                        <TextBlock Text="%" Style="{StaticResource UnitStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- GPU -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="GPU" Style="{StaticResource HeaderStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GpuUsage, StringFormat={}{0:0}, Mode=OneWay}" Style="{StaticResource ValueStyle}" FontSize="20"/>
                        <TextBlock Text="%" Style="{StaticResource UnitStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
